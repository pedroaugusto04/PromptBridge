# PromptBridge Environment Variables Example

# ==============================================================================
# ACTIVE PROVIDER SELECTION
# ==============================================================================
# Controls which LLM provider is active by default.
# Supported options: "ollama", "openai", "deepseek", "mock"
PROMPTBRIDGE_GENERAL_DEFAULT_PROVIDER=ollama

# Target language for prompt translation (e.g. "en", "es", "fr")
PROMPTBRIDGE_TARGET_LANGUAGE=en

# Display mode for CLI Proxy Gateway ("preview" or "silent")
PROMPTBRIDGE_MODE=preview

# Default LLM sampling temperature
PROMPTBRIDGE_TEMPERATURE=0.2

# HTTP Request Timeout in Seconds (Prevents CLI from hanging indefinitely)
PROMPTBRIDGE_REQUEST_TIMEOUT_SECONDS=30

# ==============================================================================
# PROVIDER CREDENTIALS & ENDPOINTS
# ==============================================================================

# Ollama Settings (Used when PROMPTBRIDGE_GENERAL_DEFAULT_PROVIDER=ollama)
PROMPTBRIDGE_OLLAMA_BASE_URL=http://localhost:11434
PROMPTBRIDGE_OLLAMA_MODEL=llama3.2

# OpenAI Settings (Used when PROMPTBRIDGE_GENERAL_DEFAULT_PROVIDER=openai)
OPENAI_API_KEY=sk-proj-your-openai-key-here
PROMPTBRIDGE_OPENAI_BASE_URL=https://api.openai.com/v1
PROMPTBRIDGE_OPENAI_MODEL=gpt-4o-mini

# DeepSeek Settings (Used when PROMPTBRIDGE_GENERAL_DEFAULT_PROVIDER=deepseek)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
